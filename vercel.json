{
  "redirects": [
    {
      "source": "/solgames",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/solgames/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/solgames/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/solgames/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/solgames/:path*/",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!_next/static|.*\\.(?:png|svg|ico|webp|woff2)$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
